    m_Localized: "\u5C0F\u9EA6\u7B49\u8C37\u7269\u7269\u54C1\uFF0C\u53EF\u4F5C\u4E3A\u5C45\u6C11\u98DF\u7269\u4E0E\u519C\u7530\u79CD\u5B50\u3002"
