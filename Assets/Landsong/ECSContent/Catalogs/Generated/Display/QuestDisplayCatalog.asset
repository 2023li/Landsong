  - Id: main_build_farms_3
    Description: "\u7CAE\u98DF\u662F\u805A\u843D\u5EF6\u7EED\u7684\u6839\u57FA\u3002\u5EFA\u9020
      3 \u5EA7\u519C\u7530\uFF0C\u8BA9\u8352\u5730\u62E5\u6709\u5B55\u80B2\u6536\u83B7\u7684\u53EF\u80FD\u3002"
    Icon: {fileID: 0}
  - Id: main_build_residential_houses_3
    Description: "\u7530\u5730\u5DF2\u7ECF\u5F00\u59CB\u751F\u957F\uFF0C\u767E\u59D3\u4E5F\u9700\u8981\u7A33\u5B9A\u7684\u5C45\u6240\u3002\u5EFA\u9020
      3 \u5EA7\u5C45\u6C11\u623F\uFF0C\u8BA9\u805A\u843D\u771F\u6B63\u624E\u6839\u3002"
    Icon: {fileID: 0}
  - Id: main_camera_survey
    Description: "\u65B0\u7684\u9886\u5730\u6B63\u5728\u773C\u524D\u5C55\u5F00\u3002\u79FB\u52A8\u5E76\u7F29\u653E\u89C6\u91CE\u5DE1\u89C6\u56DB\u5468\uFF0C\u4E3A\u805A\u843D\u9009\u5B9A\u7B2C\u4E00\u7247\u843D\u811A\u4E4B\u5730\u3002"
    Icon: {fileID: 0}
  - Id: main_collect_building_materials
    Description: "\u805A\u843D\u7684\u5EFA\u8BBE\u79BB\u4E0D\u5F00\u6700\u57FA\u7840\u7684\u6750\u6599\u3002\u6536\u96C6\u6CE5\u571F\u3001\u539F\u6728\u4E0E\u77F3\u5934\uFF0C\u4E3A\u7B2C\u4E00\u6279\u519C\u7530\u5907\u9F50\u7269\u8D44\u3002"
    Icon: {fileID: 0}
  - Id: main_plant_farms_3
    Description: "\u7A7A\u7F6E\u7684\u7530\u5730\u4E0D\u4F1A\u81EA\u884C\u5E26\u6765\u6536\u6210\u3002\u6253\u5F00\u519C\u7530\u8BE6\u60C5\uFF0C\u4E3A
      3 \u5EA7\u519C\u7530\u9009\u62E9\u4F5C\u7269\u5E76\u5B8C\u6210\u64AD\u79CD\u3002"
    Icon: {fileID: 0}
  - Id: main_select_technology
    Description: "\u751F\u5B58\u6709\u4E86\u4FDD\u969C\uFF0C\u805A\u843D\u8BE5\u628A\u76EE\u5149\u6295\u5411\u672A\u6765\u3002\u6253\u5F00\u79D1\u6280\u7CFB\u7EDF\uFF0C\u9009\u62E9\u4E00\u9879\u79D1\u6280\u4F5C\u4E3A\u5F53\u524D\u7814\u7A76\u3002"
    Icon: {fileID: 0}
  - Id: random_exploration_supplies
    Description: "\u5F52\u6765\u7684\u8FDC\u5F81\u961F\u53D1\u73B0\u4E86\u503C\u5F97\u7EE7\u7EED\u8C03\u67E5\u7684\u7EBF\u7D22\uFF0C\u9700\u8981\u4E00\u6279\u7269\u8D44\u7EC4\u7EC7\u540E\u7EED\u52D8\u5BDF\u3002"
    Icon: {fileID: 0}
  - Id: random_supply_soil
    Description: "\u4E00\u652F\u62D3\u8352\u961F\u9700\u8981\u6CE5\u571F\u6574\u5E73\u8425\u5730\uFF0C\u6B63\u5728\u5411\u9886\u5730\u5F81\u96C6\u7269\u8D44\u3002"
    Icon: {fileID: 0}
  - Id: random_supply_stone
    Description: "\u90BB\u8FD1\u805A\u843D\u6B63\u5728\u52A0\u56FA\u57CE\u5899\uFF0C\u5E0C\u671B\u91C7\u8D2D\u4E00\u6279\u77F3\u5934\u3002"
    Icon: {fileID: 0}
  - Id: random_supply_wood
    Description: "\u5546\u961F\u9700\u8981\u4E00\u6279\u539F\u6728\u7528\u4E8E\u4FEE\u7F2E\u8F66\u8F86\uFF0C\u613F\u610F\u652F\u4ED8\u91D1\u5E01\u6536\u8D2D\u3002"
    Icon: {fileID: 0}
